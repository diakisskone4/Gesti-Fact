{
  "expo": {
    "name": "Gesti-Fact",
    "slug": "gesti-fact",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ci.gestifact.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F3A5F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "ci.gestifact.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Gesti-Fact",
      "shortName": "Gesti-Fact",
      "themeColor": "#1F3A5F",
      "backgroundColor": "#F4F6F9"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Gesti-Fact accède à vos photos pour le logo et la signature de votre entreprise."
        }
      ]
    ],
    "scheme": "gestifact",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F3A5F"
    }
  }
}
